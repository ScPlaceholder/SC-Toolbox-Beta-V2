# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/

# Build artifacts (keep build scripts, ignore generated files)
build/staging/
build/Output/
build/Releases/
build/*.zip
build/get-pip.py
build/build_log_*
build/**/bin/
build/**/obj/

# Virtual environments
.venv/
venv/
env/

# pytest
.pytest_cache/

# Logs (runtime-generated, may contain personal paths)
logs/
*.log
*.log.*

# Coverage / dev-only artifacts
.coverage
**/.coverage
htmlcov/
**/htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
desktop.ini
.DS_Store

# Settings (user-specific, not shared)
skill_launcher_settings.json
nul.lock

# Per-user runtime caches (regenerated on demand by each skill)
**/.cargo_cache.json
**/.erkul_cache.json
**/.uex_cache.json
**/.scmdb_cache*.json
**/.fy_hardpoints_cache.json
**/.craft_cache/
**/.api_cache/
**/.mining_chart_cache.json
**/.signals_cache.json
**/.scratch_cache.json

# Per-user runtime data (refinery / mining / fleet / loadouts)
mining_ledger.json
fleet_snapshots.json
refinery_orders.json
mining_loadout_config.json
mining_signals_config.json
battle_buddy_settings.json
cargo_loader_config.json
labeler_err.txt
labeler.log

# Trained / per-user OCR models (local artifacts, not shipped)
tools/Mining_Signals/ocr/models/model_signal_cnn.json

# Dev audit reports (regenerable from current code)
**/audit_report.txt
**/*_audit_report.txt

# Claude Code (session-specific, not shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Mining Signals OCR training data — keep locally, never push (J 2026-07-22)
tools/Mining_Signals/training_data_clean/

# Starmap (Red/Kimi, 2026-09-23): no backups in git
skills/Starmap/**/*.bak*

# set_route_ai: no backup copies in git
tools/set_route_ai/**/*.bak*
tools/set_route_ai/**/*backup*.py

# SuitMk2: no voices, models, backups or files over 5 MB in git (the installer fetches them)
tools/SuitMk2/voices/*
!tools/SuitMk2/voices/README.md
tools/SuitMk2/**/*.onnx
tools/SuitMk2/**/*.gguf
tools/SuitMk2/models/yamnet/yamnet.data
tools/SuitMk2/**/*.bak*

# Debug captures and local archives (runtime/dev leftovers, not source)
/debug_*.png
/chart_header_debug.png
/tools/debug_*.png
/tools/*.zip

# Agent worktrees (full copies of the repo; never commit)
**/.claude/worktrees/

# The whole folder, not its contents one by one. Lines 83-84 and 111 enumerated
# settings.local.json, scheduled_tasks.lock and worktrees/ individually, so
# tool_cloning_prompt.enc — added later — was never covered and shipped publicly.
.claude/

# Pico generated assets. Stub runs produce 26 placeholder PNGs and real runs produce paid art;
# neither belongs in the repo. The MANIFEST is tracked (it is source), the output is not.
tools/Pico/out/

tools/Pico/out_placed/

# Pico outfit packs: 12-18 MB each, over the 5 MB a file this repository takes. packs.json IS tracked.
# The build copies or downloads the default pack and checks it against packs.json.
tools/Pico/packs/*.tar.xz

# Files build/assets_from_release.py takes out of a release package (large binaries, never in git)
build/release_assets/

# The installer that dotnet publish writes (about 2 GB)
build/installer_ui/publish/
