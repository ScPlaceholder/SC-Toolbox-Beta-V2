<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SC_Toolbox.Installer</RootNamespace>
    <AssemblyName>SC_Toolbox_Setup</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Single self-contained .exe — easier to ship than runtime-dependent.
         Result is ~80 MB but Velopack's bundled .nupkg dwarfs that anyway. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Required for our bundled Velopack Setup.exe to land on disk at
         AppContext.BaseDirectory at runtime. Without it, Content files
         stay inside the bundle and FindSetupExe() can't see them as files
         on disk to spawn as a subprocess. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- ★★★ 2026-08-17 - STOP EMBEDDING THE BUILD MACHINE'S PATH IN THE SHIPPED .EXE.
         Every installer we have shipped carries exactly one copy of
         C:\Users\<name>\AppData\Roaming\ShipBit\... and it is NOT a staged file and NOT a
         source string, so sanitize_staging.py could never have caught it - that scrub only
         walks tools/Mining_Signals.
         It is the PE CodeView debug directory: the compiler records the absolute path of the
         .pdb next to an "RSDS" marker so a debugger can find symbols later. Verified by
         grepping the built .exe - the single hit sits immediately after RSDS.
         DebugType=none omits the debug directory entirely. We neither ship nor serve symbols
         for the installer, so nothing is lost. If usable stack traces are ever wanted instead,
         the alternative is Deterministic + PathMap rather than reinstating this. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Branding -->
    <ApplicationIcon>..\..\assets\sc_toolbox.ico</ApplicationIcon>
    <!-- ★★★ 2026-08-17 — VERSION IS DERIVED, NOT TYPED. See the SyncVersionFromPyproject target
         at the bottom of this file. These two lines are only a fallback for the case where
         pyproject.toml cannot be read; if the target runs (it does), it overwrites them.
         WHY: this csproj said 2.2.16 while pyproject.toml said 2.3.0, so for two releases the
         installer WINDOW announced v2.2.16 while installing 2.3.x — the thing installing itself
         was lying about what it was, in the one place a user actually reads.
         J, on being told: "it's remarkable how many tiny things have silently drifted."
         Bumping both by hand would have fixed today and guaranteed a repeat, because a value
         written down twice drifts the moment someone edits one copy in a hurry.
         [[dont-write-a-second-copy-of-a-value-that-already-exists]] -->
    <Version>0.0.0-fallback</Version>
    <FileVersion>0.0.0</FileVersion>
    <Product>SC Toolbox Installer</Product>
    <Company>SC Toolbox</Company>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <!-- Background images embedded as resources so they ship inside the .exe.
       Drop additional .jpg/.png files into Resources/Backgrounds/ and they
       auto-rotate. Filenames are sorted lexically — name them e.g. bg01.jpg,
       bg02.jpg if you want a specific order. -->
  <ItemGroup>
    <Resource Include="Resources\Backgrounds\*.jpg" />
    <Resource Include="Resources\Backgrounds\*.png" />
  </ItemGroup>

  <!-- Bundle Velopack's Setup.exe alongside our custom UI as a single .exe.
       .NET 8's single-file publish bundles all <Content> items into the
       output binary; on first run it self-extracts to %LOCALAPPDATA%\.net\
       and our launcher reads Setup.exe from AppContext.BaseDirectory.
       Tradeoff: ~1.4 GB single-file installer vs. zip-with-two-files.
       Fallback if anything goes wrong: revert this change, ship as zip. -->
  <ItemGroup>
    <Content Include="..\Releases\SC_Toolbox-win-Setup.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Microsoft VC++ 2015-2022 Redistributable (x64).  The Mining
         Signals OCR pipeline links onnxruntime, which requires
         vcruntime140.dll / msvcp140.dll.  On Windows installs that
         don't have them (clean Windows / Windows N / locked-down
         enterprise) onnxruntime can't load and the scanner silently
         dies with both CNN voters reporting "unavailable" — the
         v2.2.10 user-reported failure.  MainWindow.xaml.cs silent-
         installs this at the start of StartInstallAsync, no-op'd when
         the runtime is already present (registry-checked, no UAC).
         Downloaded from https://aka.ms/vs/17/release/vc_redist.x64.exe -->
    <Content Include="vc_redist.x64.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- ★★★ SINGLE SOURCE OF TRUTH FOR THE VERSION (Elah, 2026-08-17).
       pyproject.toml is what velopack reads (via build/read_version.py) to stamp the package.
       This target makes the installer UI read the SAME file instead of keeping its own copy,
       so the window, the package and the git tag cannot disagree again.

       It ran before Build so the value is in place for the compiler, and it FAILS LOUDLY rather
       than silently shipping the fallback — a version sync that quietly does nothing is exactly
       the drift it exists to prevent, and would be indistinguishable from working.  -->
  <Target Name="SyncVersionFromPyproject" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_PyprojectPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\pyproject.toml'))</_PyprojectPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PyprojectPath)')"
           Text="Version sync FAILED: pyproject.toml not found at $(_PyprojectPath). Refusing to build with a stale hardcoded version." />
    <PropertyGroup>
      <_PyprojectText>$([System.IO.File]::ReadAllText('$(_PyprojectPath)'))</_PyprojectText>
      <_PyVersion>$([System.Text.RegularExpressions.Regex]::Match($(_PyprojectText), 'version\s*=\s*"([^"]+)"').Groups[1].Value)</_PyVersion>
    </PropertyGroup>
    <Error Condition="'$(_PyVersion)' == ''"
           Text="Version sync FAILED: no version = &quot;x.y.z&quot; line in $(_PyprojectPath). Refusing to build with a stale hardcoded version." />
    <PropertyGroup>
      <Version>$(_PyVersion)</Version>
      <FileVersion>$(_PyVersion)</FileVersion>
      <AssemblyVersion>$(_PyVersion)</AssemblyVersion>
    </PropertyGroup>
    <Message Importance="high" Text="  [version] installer UI synced to $(_PyVersion) from pyproject.toml" />
  </Target>

</Project>
